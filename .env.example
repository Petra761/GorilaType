# Supabase PostgreSQL (Session Pooler - IPv4)
# Conexión para runtime de la Web API (rol gorilatype_app con RLS)
ConnectionStrings__DefaultConnection=

# Conexión exclusiva para migraciones de EF Core (rol postgres con BYPASSRLS)
ConnectionStrings__MigrationsConnection=

# Configuración de JWT
Jwt__Issuer=GorilaType.Api
Jwt__Audience=GorilaType.Client
Jwt__ExpirationMinutes=15
Jwt__Secret=

# Configuración de SMTP (Gmail - envío de correos)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=gorilatype.noreply@gmail.com
Smtp__Password=
Smtp__FromEmail=gorilatype.noreply@gmail.com
Smtp__FromName=GorilaType